---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('log')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: '2-digit' });
---
<Base title="Log — Caleb" description="Build log: running notes on what I'm building and breaking.">
  <main class="wrap">
    <header class="head">
      <p class="kicker">build log</p>
      <h1>Running notes on what I'm building — and breaking.</h1>
    </header>
    <ol reversed>
      {entries.map((e) => (
        <li>
          <span class="idx mono">#{e.id.split('-')[0]}</span>
          <div>
            <a href={`/log/${e.id}`}>{e.data.title}</a>
            <p>{e.data.summary}</p>
            <p class="meta mono">
              <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              {e.data.tags.length > 0 && <span> · {e.data.tags.join(' · ')}</span>}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .head { padding-block: var(--sp-3xl) var(--sp-xl); }
  .head h1 {
    font-size: var(--step-2);
    max-width: 24ch;
    margin-top: var(--sp-sm);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--sp-3xl);
    display: grid;
    gap: var(--sp-xl);
  }
  li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-top: var(--sp-lg);
  }
  .idx { color: var(--text-low); font-size: 0.8rem; }
  li a { font-family: var(--font-display); font-size: var(--step-1); font-weight: 640; color: var(--text-hi); }
  li p { margin: var(--sp-sm) 0 0; color: var(--text-mid); max-width: 56ch; }
  .meta { color: var(--text-low); font-size: 0.75rem; }
  @media (max-width: 40rem) {
    li { grid-template-columns: 1fr; }
    .idx { display: none; }
  }
</style>
