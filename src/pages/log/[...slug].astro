---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('log');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${entry.data.title} — Caleb`} description={entry.data.summary}>
  <main class="wrap">
    <article>
      <header class="head">
        <p class="meta mono">
          #{entry.id.split('-')[0]} ·
          <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
          {entry.data.tags.length > 0 && <span> · {entry.data.tags.join(' · ')}</span>}
        </p>
        <h1>{entry.data.title}</h1>
      </header>
      <div class="prose">
        <Content />
      </div>
      <p class="back mono"><a href="/log">← back to the log</a></p>
    </article>
  </main>
</Base>

<style>
  .head { padding-block: var(--sp-3xl) var(--sp-xl); max-width: var(--measure); }
  .head h1 { font-size: var(--step-2); margin-top: var(--sp-md); }
  .meta { color: var(--text-low); font-size: 0.8rem; }
  .back { padding-block: var(--sp-xl) var(--sp-3xl); font-size: 0.85rem; }
</style>
